+/** Explicit reviewed activation API. Not called by bootstrap, workers or replay CLI. */
+import {createHash} from "node:crypto";
+import {withTransaction,type PgLike} from "../db/client.js";
+import {fetchFinalizedPositionSnapshot,lockCompleteHistory,assertFinalizedHistoryCoverage,type PositionsSyncRpc,type RecoveryPrograms} from "./positionsSync.js";
