+  const mintAddress = new PublicKey(state.shareMint);
+  const holders = await withRpcBackoff(() => boundedSnapshotRead(() => rpc.getProgramAccounts(TOKEN_2022_PROGRAM_ID,{
+    commitment:"finalized",encoding:"base64",withContext:true,minContextSlot:account.context.slot,
+    filters:[{memcmp:{offset:0,bytes:state.shareMint}}],
+  }),deadline),{sleep:backoffSleep,logKey:"positionsSync:finalized-holders"});
+  if (!Number.isSafeInteger(holders.context?.slot) || !Array.isArray(holders.value)) throw new Error("Missing finalized holder context");
