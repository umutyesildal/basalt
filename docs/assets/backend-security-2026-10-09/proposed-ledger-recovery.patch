+/** All holder bytes and mint supply must be authenticated at exactly one finalized slot. */
+async function fetchFinalizedPositionSnapshotOnce(rpc:PositionsSyncRpc,basket:string,programs:RecoveryPrograms,backoffSleep:((ms:number)=>Promise<void>)|undefined,deadline:number): Promise<FinalizedPositionSnapshot> {
+  const address = new PublicKey(basket);
+  const account = await withRpcBackoff(() => boundedSnapshotRead(() => rpc.getAccountInfoAndContext(address,{commitment:"finalized"}),deadline),{sleep:backoffSleep,logKey:"positionsSync:basket"});
