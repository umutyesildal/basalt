+export async function activateStagedPositionRebuild(db:PgLike,rpc:PositionsSyncRpc,runId:string,expectedHistoryHash:string,programs:RecoveryPrograms):Promise<void> {
+  if (!runId || !/^[a-f0-9]{64}$/.test(expectedHistoryHash)) throw new Error("Explicit reviewed run/hash required");
+  await withTransaction(db,async client => {
+    const found = (await client.query("SELECT * FROM position_rebuild_runs WHERE run_id=$1",[runId])).rows[0];
+    if (!found || found.status !== 'staged-pending-review' || found.history_hash !== expectedHistoryHash) throw new Error("Reviewed staged run not available");
+    if (JSON.stringify([...programs.ids].sort()) !== JSON.stringify([...(found.program_ids ?? [])].sort())) throw new Error("Program attestation differs from staging");
+    await lockCompleteHistory(client,found.basket,programs.ids);
+    const run = (await client.query("SELECT * FROM position_rebuild_runs WHERE run_id=$1 FOR UPDATE",[runId])).rows[0];
+    if (run.status !== 'staged-pending-review') throw new Error("Run already activated or superseded");
+    const stableFields = ["basket","history_hash","chain_slot","chain_supply","event_count"] as const;
+    if (stableFields.some(field=>String(run[field])!==String(found[field])) || run.history_hash!==expectedHistoryHash ||
+        JSON.stringify([...(run.program_ids ?? [])].sort())!==JSON.stringify([...programs.ids].sort())) {
+      throw new Error("Reviewed run metadata changed while acquiring locks; restage/review");
+    }
+    const pending = (await client.query("SELECT basket FROM position_rebuild_required WHERE basket=$1 AND (activated_run_id IS NULL OR NOT EXISTS(SELECT 1 FROM position_rebuild_runs activated WHERE activated.run_id=position_rebuild_required.activated_run_id AND activated.basket=position_rebuild_required.basket AND activated.status='activated')) FOR UPDATE",[run.basket])).rows;
+    if (pending.length !== 1) throw new Error("No quarantined projection to activate");
+    const history = (await client.query("SELECT sig,log_index,type,data,slot::text AS slot FROM events WHERE basket=$1 AND log_index>=0 ORDER BY slot,sig,log_index",[run.basket])).rows;
+    if (history.length !== run.event_count || createHash('sha256').update(JSON.stringify(history)).digest('hex') !== expectedHistoryHash) throw new Error("Canonical history changed; restage");
+    const snapshot = await fetchFinalizedPositionSnapshot(rpc,run.basket,programs);
+    await assertFinalizedHistoryCoverage(client,programs.ids,snapshot.slot);
+    if (BigInt(snapshot.slot) < BigInt(run.chain_slot) || snapshot.supply !== String(run.chain_supply)) throw new Error("Finalized snapshot no longer matches staged supply");
+    if (history.some(row => BigInt(row.slot)>BigInt(snapshot.slot))) throw new Error("Snapshot predates history");
+    const staged = (await client.query('SELECT "user" AS user,share_balance::text AS shares FROM position_rebuild_staging WHERE run_id=$1 ORDER BY "user"',[runId])).rows;
+    const normalized = snapshot.balances.filter(row=>BigInt(row.shares)>0n).map(row=>({user:row.user,shares:BigInt(row.shares).toString()})).sort((a,b)=>a.user.localeCompare(b.user));
+    const normalize = (rows:Array<{user:string;shares:string}>)=>rows.map(row=>`${row.user}:${BigInt(row.shares)}`).sort().join('\n');
+    if (normalize(staged)!==normalize(normalized)) throw new Error("Finalized holders changed; restage");
+    const stagedClaims = (await client.query("SELECT sig,log_index,kind,basket FROM position_rebuild_claims WHERE run_id=$1 ORDER BY sig,log_index",[runId])).rows;
+    const expectedClaims = history.filter(row=>row.type!=='BasketCreated').map(row=>({sig:row.sig,log_index:row.log_index,kind:row.type,basket:run.basket})).sort((a,b)=>a.sig.localeCompare(b.sig)||a.log_index-b.log_index);
+    if (JSON.stringify(stagedClaims)!==JSON.stringify(expectedClaims)) throw new Error("Staged claims differ from canonical history");
+    // Immutable backups commit atomically with publication; any later fault rolls all changes back.
+    await client.query(`INSERT INTO position_rebuild_positions_backup(run_id,"user",basket,share_balance,cost_basis,cost_basis_source,position_updated_at)
+      SELECT $1,"user",basket,share_balance,cost_basis,cost_basis_source,updated_at FROM user_positions WHERE basket=$2`,[runId,run.basket]);
+    await client.query(`INSERT INTO position_rebuild_claims_backup(run_id,sig,log_index,kind,basket,claimed_at)
+      SELECT $1,sig,log_index,kind,basket,ts FROM position_events WHERE basket=$2`,[runId,run.basket]);
+    const users = normalized.map(row=>row.user);
+    await client.query(`UPDATE user_positions SET share_balance=0,cost_basis=NULL,cost_basis_source=NULL,updated_at=NOW()
+      WHERE basket=$1 AND NOT("user"=ANY($2::text[]))`,[run.basket,users]);
+    for (const holder of normalized) await client.query(`INSERT INTO user_positions("user",basket,share_balance,cost_basis,cost_basis_source)
+      VALUES($1,$2,$3,NULL,NULL) ON CONFLICT("user",basket) DO UPDATE SET share_balance=EXCLUDED.share_balance,cost_basis=NULL,cost_basis_source=NULL,updated_at=NOW()`,[holder.user,run.basket,holder.shares]);
+    for (const claim of stagedClaims) {
+      const conflict = (await client.query("SELECT kind,basket FROM position_events WHERE sig=$1 AND log_index=$2",[claim.sig,claim.log_index])).rows[0];
+      if (conflict && (conflict.kind!==claim.kind || conflict.basket!==claim.basket)) throw new Error("Canonical claim collision");
