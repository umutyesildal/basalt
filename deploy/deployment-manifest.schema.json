{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://basalt.example/deployment-manifest.schema.json",
  "title": "Basalt deployment and artifact manifest",
  "description": "Version-controlled shape for source, deployment, toolchain, dependency, and optional artifact evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "generatedAt",
    "git",
    "deployment",
    "programs",
    "toolchain",
    "dependencies",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "type": "integer", "const": 2 },
    "project": { "type": "string", "const": "basalt" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$" },
        "dirty": { "type": "boolean" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "cluster", "rpcUrl", "status", "upgradeAuthority", "deployedSlot", "governance"],
      "properties": {
        "environment": { "type": "string", "minLength": 1 },
        "cluster": { "type": "string", "minLength": 1 },
        "rpcUrl": { "type": ["string", "null"], "format": "uri" },
        "status": { "type": "string", "enum": ["not-attested", "attested-inputs", "verified"] },
        "upgradeAuthority": { "type": ["string", "null"], "minLength": 1 },
        "deployedSlot": { "type": ["integer", "null"], "minimum": 0 },
        "governance": { "$ref": "#/$defs/governance" }
      }
    },
    "programs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basket", "basket_factory", "whitelist"],
      "properties": {
        "basket": { "$ref": "#/$defs/program" },
        "basket_factory": { "$ref": "#/$defs/program" },
        "whitelist": { "$ref": "#/$defs/program" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "npm", "rustc", "cargo", "solanaCli", "anchor"],
      "properties": {
        "node": { "type": ["string", "null"] },
        "npm": { "type": ["string", "null"] },
        "rustc": { "type": ["string", "null"] },
        "cargo": { "type": ["string", "null"] },
        "solanaCli": { "type": ["string", "null"] },
        "anchor": { "type": ["string", "null"] }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locks"],
      "properties": {
        "locks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root", "app", "backend"],
          "properties": {
            "root": { "$ref": "#/$defs/lock" },
            "app": { "$ref": "#/$defs/lock" },
            "backend": { "$ref": "#/$defs/lock" }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elf", "images"],
      "properties": {
        "elf": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "digest"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "digest": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "authorityModel": {
      "type": "string",
      "enum": ["single-key", "multisig", "immutable", "unknown"]
    },
    "authoritySource": {
      "type": "string",
      "enum": ["rpc", "operator-declaration", "unknown"]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityModel",
        "authoritySource",
        "authorityVerifiedAt",
        "multisigAddress",
        "threshold",
        "signerCount",
        "signers",
        "timelock",
        "transferRehearsal"
      ],
      "properties": {
        "authorityModel": { "$ref": "#/$defs/authorityModel" },
        "authoritySource": { "$ref": "#/$defs/authoritySource" },
        "authorityVerifiedAt": { "type": ["string", "null"], "format": "date-time" },
        "multisigAddress": { "type": ["string", "null"], "minLength": 32 },
        "threshold": { "type": ["integer", "null"], "minimum": 2 },
        "signerCount": { "type": ["integer", "null"], "minimum": 3 },
        "signers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "publicKey"],
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "publicKey": { "type": "string", "minLength": 32 }
            }
          }
        },
        "timelock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "delaySeconds", "announcementPeriodSeconds", "policyUrl"],
          "properties": {
            "status": { "type": "string", "enum": ["not-configured", "configured", "verified", "unknown"] },
            "delaySeconds": { "type": ["integer", "null"], "minimum": 0 },
            "announcementPeriodSeconds": { "type": ["integer", "null"], "minimum": 0 },
            "policyUrl": { "type": ["string", "null"], "format": "uri" }
          }
        },
        "transferRehearsal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "transaction", "verifiedAt"],
          "properties": {
            "status": { "type": "string", "enum": ["not-run", "passed", "failed", "unknown"] },
            "transaction": { "type": ["string", "null"], "minLength": 1 },
            "verifiedAt": { "type": ["string", "null"], "format": "date-time" }
          }
        }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["programId", "upgradeAuthority", "upgradeAuthorityModel", "authoritySource", "authorityVerifiedAt", "deployedSlot"],
      "properties": {
        "programId": { "type": ["string", "null"], "minLength": 32 },
        "upgradeAuthority": { "type": ["string", "null"], "minLength": 1 },
        "upgradeAuthorityModel": { "$ref": "#/$defs/authorityModel" },
        "authoritySource": { "$ref": "#/$defs/authoritySource" },
        "authorityVerifiedAt": { "type": ["string", "null"], "format": "date-time" },
        "deployedSlot": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
