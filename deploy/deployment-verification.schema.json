{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://basalt.example/deployment-verification.schema.json",
  "title": "Basalt read-only deployment verification evidence",
  "description": "Sidecar evidence emitted after finalized RPC reads of the canonical Basalt Program, ProgramData, and WhitelistConfig accounts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidenceVersion",
    "project",
    "sourceManifest",
    "verification",
    "programs",
    "whitelistConfig",
    "checks",
    "limitations"
  ],
  "properties": {
    "evidenceVersion": { "type": "integer", "const": 1 },
    "project": { "type": "string", "const": "basalt" },
    "sourceManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "gitCommit", "sha256", "environment", "cluster", "declaredRpcOrigin"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 2 },
        "gitCommit": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
            { "type": "null" }
          ]
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "environment": { "type": "string", "minLength": 1 },
        "cluster": { "type": "string", "minLength": 1 },
        "declaredRpcOrigin": {
          "anyOf": [
            { "type": "string", "format": "uri", "pattern": "^https?://[^/?#]+$" },
            { "type": "null" }
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source",
        "rpcOrigin",
        "commitment",
        "observedAt",
        "expectedAuthority",
        "firstReadContextSlot",
        "secondReadContextSlot"
      ],
      "properties": {
        "status": { "type": "string", "const": "verified" },
        "source": { "type": "string", "const": "rpc" },
        "rpcOrigin": { "type": "string", "format": "uri", "pattern": "^https?://[^/?#]+$" },
        "commitment": { "type": "string", "const": "finalized" },
        "observedAt": { "type": "string", "format": "date-time" },
        "expectedAuthority": { "$ref": "#/$defs/publicKey" },
        "firstReadContextSlot": { "$ref": "#/$defs/u64Decimal" },
        "secondReadContextSlot": { "$ref": "#/$defs/u64Decimal" }
      }
    },
    "programs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basket", "basket_factory", "whitelist"],
      "properties": {
        "basket": { "$ref": "#/$defs/programEvidence" },
        "basket_factory": { "$ref": "#/$defs/programEvidence" },
        "whitelist": { "$ref": "#/$defs/programEvidence" }
      }
    },
    "whitelistConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "programId",
        "accountOwner",
        "executable",
        "accountDataLength",
        "authority",
        "pendingAuthority",
        "authorityMatchesExpected",
        "readContextSlot"
      ],
      "properties": {
        "address": { "type": "string", "const": "ESRwG8qoKaLM17dLEM6MJDRpKVYtkd9M2zUmbud2uXZd" },
        "programId": { "type": "string", "const": "FRavMcYQb2FVAHbbG6fGieQHdKk1UrQqgKsAAXTPRQeS" },
        "accountOwner": { "type": "string", "const": "FRavMcYQb2FVAHbbG6fGieQHdKk1UrQqgKsAAXTPRQeS" },
        "executable": { "type": "boolean", "const": false },
        "accountDataLength": { "type": "integer", "minimum": 41 },
        "authority": { "$ref": "#/$defs/publicKey" },
        "pendingAuthority": { "type": "null" },
        "authorityMatchesExpected": { "type": "boolean", "const": true },
        "readContextSlot": { "$ref": "#/$defs/u64Decimal" }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allProgramAccountsExecutable",
        "allProgramDataAccountsNonExecutable",
        "allLoaderOwnersVerified",
        "allAuthoritiesMatchExpected",
        "whitelistAuthorityMatchesExpected",
        "whitelistPendingAuthorityEmpty",
        "noProgramDataAliases"
      ],
      "properties": {
        "allProgramAccountsExecutable": { "type": "boolean", "const": true },
        "allProgramDataAccountsNonExecutable": { "type": "boolean", "const": true },
        "allLoaderOwnersVerified": { "type": "boolean", "const": true },
        "allAuthoritiesMatchExpected": { "type": "boolean", "const": true },
        "whitelistAuthorityMatchesExpected": { "type": "boolean", "const": true },
        "whitelistPendingAuthorityEmpty": { "type": "boolean", "const": true },
        "noProgramDataAliases": { "type": "boolean", "const": true }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "publicKey": { "type": "string", "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$" },
    "u64Decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "programEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "programId",
        "programDataAddress",
        "upgradeAuthority",
        "authorityMatchesExpected",
        "programDataSlot",
        "programDataAuthorityOption",
        "programDataMetadataLength",
        "programDataLength",
        "programAccountOwner",
        "programDataAccountOwner",
        "programAccountExecutable",
        "programDataAccountExecutable",
        "programAccountDataLength",
        "programDataAccountDataLength",
        "discoveryReadContextSlot",
        "programReadContextSlot",
        "programDataReadContextSlot"
      ],
      "properties": {
        "name": { "type": "string", "enum": ["basket", "basket_factory", "whitelist"] },
        "programId": { "$ref": "#/$defs/publicKey" },
        "programDataAddress": { "$ref": "#/$defs/publicKey" },
        "upgradeAuthority": { "$ref": "#/$defs/publicKey" },
        "authorityMatchesExpected": { "type": "boolean", "const": true },
        "programDataSlot": { "$ref": "#/$defs/u64Decimal" },
        "programDataAuthorityOption": { "type": "integer", "const": 1 },
        "programDataMetadataLength": { "type": "integer", "const": 45 },
        "programDataLength": { "type": "integer", "minimum": 1 },
        "programAccountOwner": { "type": "string", "const": "BPFLoaderUpgradeab1e11111111111111111111111" },
        "programDataAccountOwner": { "type": "string", "const": "BPFLoaderUpgradeab1e11111111111111111111111" },
        "programAccountExecutable": { "type": "boolean", "const": true },
        "programDataAccountExecutable": { "type": "boolean", "const": false },
        "programAccountDataLength": { "type": "integer", "const": 36 },
        "programDataAccountDataLength": { "type": "integer", "minimum": 46 },
        "discoveryReadContextSlot": { "$ref": "#/$defs/u64Decimal" },
        "programReadContextSlot": { "$ref": "#/$defs/u64Decimal" },
        "programDataReadContextSlot": { "$ref": "#/$defs/u64Decimal" }
      }
    }
  }
}
