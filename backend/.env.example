DATABASE_URL=postgres://postgres:postgres@localhost:5432/foliox
REDIS_URL=redis://localhost:6379
RPC_URL=https://api.devnet.solana.com
# Optional private devnet RPC supporting finalized Token-2022 getProgramAccounts.
# Used for the WHOLE authenticated holder snapshot, only after devnet genesis verification.
# Leave empty without a provider; public RPC may exclude Token-2022 from its account index.
POSITIONS_RPC_URL=
# Unsupported account-index queries are probed at most once per cooldown (15min default).
POSITIONS_RPC_UNSUPPORTED_COOLDOWN_MS=900000
# Shared per-endpoint read-only budget across indexer, holdings, NAV and keeper reads.
RPC_MAX_CONCURRENCY=2
RPC_MAX_QUEUE=32
RPC_MIN_INTERVAL_MS=250
RPC_QUEUE_TIMEOUT_MS=2000
RPC_REQUEST_TIMEOUT_MS=8000
HELIUS_API_KEY=
PROGRAM_WHITELIST=FRavMcYQb2FVAHbbG6fGieQHdKk1UrQqgKsAAXTPRQeS
PROGRAM_FACTORY=3hzoPep9JKgTmzLT6CNW5x3EN7WNYDevM6KHVM7pLgMF
PROGRAM_BASKET=6Q43vFh4aqGxzvtU2vQwJX9PmX3skfYsGWZdA3fwJB9k
PORT=3001
# Indexer (Wave B): poll interval/limit for getSignaturesForAddress polling
INDEXER_POLL_MS=15000
INDEXER_POLL_LIMIT=50
# Read-only mainnet xStock prices (independent from RPC_URL devnet transactions).
# Optional Jupiter key; never expose it via NEXT_PUBLIC variables.
JUPITER_API_KEY=
# Optional mainnet RPC for quote block timestamps. Defaults to public Solana mainnet.
PRICE_MAINNET_RPC_URL=
# Shared quote worker: full issuer catalog every5min, recently viewed mints every1min.
# Only during NYSE cash hours09:30-16:00America/New_York, with published holidays/early closes.
# Closed sessions serve saved prices without upstream quote/catalog/RPC requests.
# Refreshes are paced for keyless Jupiter access; unknown prices stay unavailable.
XSTOCK_PRICE_WORKER=1
XSTOCK_PRICE_FULL_REFRESH_MS=300000
XSTOCK_PRICE_HOT_REFRESH_MS=60000
# Optional public-data cache path; default backend/.cache/xstocks-prices.json.
# Set to0 to disable disk persistence. Never stores keys or account balances.
XSTOCK_PRICE_CACHE_PATH=
# Historical completed-day DEX charts are read on request, even when the live quote session is closed.
# Default backend/.cache/xstocks-history.json; set 0 to disable public history persistence.
XSTOCK_HISTORY_CACHE_PATH=
# Explicit dev-only fallback. Public xStock price routes always disable it.
# Set to "mock" to enable labeled mock fallback for dev NAV when Jupiter is down
PRICE_FALLBACK=

# Social layer — HMAC secret for wallet-auth tokens (social writes only).
# NOTE: keep it in .env (NOT .env.devnet — that profile is secret-free by test invariant,
# see tests/devnet-catalog.test.ts). When starting the demo backend source both files.
SOCIAL_AUTH_SECRET=

# Required before startup: supply at least 32 random bytes (openssl rand -hex 32).
# Missing, short, whitespace-only and known placeholder secrets fail before workers/listen.
# Local development only: opt into a process-random, restart-invalidated secret.
# Never enable this in production; production always requires the generated secret.
SOCIAL_AUTH_ALLOW_DEV_SECRET=0
