# Basalt backend — secret-free devnet profile.
# Copy to .env.devnet for local use, then override credentials privately.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/foliox_devnet
RPC_URL=https://api.devnet.solana.com
PROGRAM_WHITELIST=FRavMcYQb2FVAHbbG6fGieQHdKk1UrQqgKsAAXTPRQeS
PROGRAM_FACTORY=3hzoPep9JKgTmzLT6CNW5x3EN7WNYDevM6KHVM7pLgMF
PROGRAM_BASKET=6Q43vFh4aqGxzvtU2vQwJX9PmX3skfYsGWZdA3fwJB9k
PORT=3001

# Shared public-devnet pacing.
INDEXER_POLL_MS=30000
INDEXER_POLL_LIMIT=20
HOLDINGS_SYNC_INTERVAL_MS=60000

# Enable the read-only workers. The backend still never signs transactions.
NAV_ENGINE=1
FEE_CRANK=1

# Devnet mock catalog prices are explicitly labeled. PRICE_FALLBACK remains
# unset so production-style price failures do not silently become zeroes.
REALISTIC_MOCK_PRICES=1
