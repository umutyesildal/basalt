# Basalt backend — production env template.
# Copy to backend/.env.production on the server and fill in the values.
# DATABASE_URL is NOT set here: docker compose injects it (internal Postgres).
# Redis is intentionally absent (in-memory cache fallback; see compose comment).

# --- Solana (devnet demo profile) ---
RPC_URL=https://api.devnet.solana.com
# Optional: Helius key if you have one (higher rate limits than public RPC).
HELIUS_API_KEY=
PROGRAM_WHITELIST=FRavMcYQb2FVAHbbG6fGieQHdKk1UrQqgKsAAXTPRQeS
PROGRAM_FACTORY=3hzoPep9JKgTmzLT6CNW5x3EN7WNYDevM6KHVM7pLgMF
PROGRAM_BASKET=6Q43vFh4aqGxzvtU2vQwJX9PmX3skfYsGWZdA3fwJB9k

# --- Indexer / pricing ---
INDEXER_POLL_MS=15000
INDEXER_POLL_LIMIT=50
# Set to "mock" only for local demos when Jupiter is down — keep EMPTY in prod.
PRICE_FALLBACK=

# --- Social auth (HMAC secret for wallet-auth tokens) ---
# Generate on the server: openssl rand -hex 32
SOCIAL_AUTH_SECRET=CHANGE_ME
